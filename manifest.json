{
  "manifest_version": 3,
  "name": "Lux",
  "version": "1.4",
  "description": "Seçtiğiniz metni sağ tık menüsünden veya klavye kısayoluyla renkli vurgulayın; kısayolla geri alın.",
  "permissions": ["contextMenus", "activeTab", "scripting"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Lux",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true
    },
    {
      "matches": ["https://satquestionbank.org/*", "https://www.satquestionbank.org/*"],
      "css": ["bluebook.css"],
      "js": ["bluebook.js"]
    }
  ],
  "commands": {
    "highlight-selection": {
      "suggested_key": { "default": "Ctrl+Shift+H" },
      "description": "Seçili metni son kullanılan renkle vurgula"
    },
    "undo-highlight": {
      "suggested_key": { "default": "Ctrl+Shift+Z" },
      "description": "Son vurgulamayı geri al"
    }
  }
}
